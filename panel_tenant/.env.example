PANEL_PORT=4173
PANEL_HOST=127.0.0.1
PANEL_DATA_DIR=data
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD=cambia-esta-clave

# dry-run no crea recursos. Cambia a real para ejecutar Terraform/Pulumi.
PANEL_PROVISION_MODE=dry-run
PANEL_TERRAFORM_AWS_DIR=../terraform/aws
PANEL_TERRAFORM_AZURE_DIR=../terraform/azure
PANEL_PULUMI_AWS_DIR=../pulumi/aws
PANEL_PULUMI_AZURE_DIR=../pulumi/azure
PANEL_PULUMI_PASSPHRASE=pulumi
# Comandos opcionales si los ejecutables no están en PATH.
PANEL_CHECKOV_COMMAND=checkov
PANEL_TFSEC_COMMAND=tfsec
PANEL_TFLINT_COMMAND=tflint
PANEL_APP_VERSION=main
PANEL_TEMPLATE_VERSION=1.0.0

# Opcional si Terraform no encuentra los valores en terraform.tfvars.
PANEL_DATABASE_AMI_ID=
PANEL_BACKEND_AMI_ID=
PANEL_FRONTEND_AMI_ID=

# Azure usa Azure CLI (az login) y estas imágenes administradas de Packer.
PANEL_AZURE_SUBSCRIPTION_ID=
PANEL_AZURE_LOCATION=eastus2
PANEL_AZURE_RESOURCE_GROUP_NAME=
PANEL_AZURE_ADMIN_USERNAME=azureuser
PANEL_AZURE_SSH_PUBLIC_KEY=
PANEL_AZURE_DATABASE_IMAGE_ID=
PANEL_AZURE_BACKEND_IMAGE_ID=
PANEL_AZURE_FRONTEND_IMAGE_ID=
PANEL_AZURE_INSTANCE_TYPE=Standard_D2ads_v7

# Preparado para conectar Prometheus/Grafana más adelante.
PANEL_PROMETHEUS_URL=http://localhost:9090
PANEL_GRAFANA_URL=http://localhost:3000
