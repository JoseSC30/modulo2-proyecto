# El proveedor AWS obtiene las credenciales desde AWS CLI, variables de entorno
# o un rol IAM. No agregues access_key ni secret_key a este archivo.
project_name          = "backend-db-app-2026"
aws_region            = "us-east-2"
availability_zone     = "us-east-2a"
instance_type         = "t2.micro"
ami_id                = "ami-09519cc56eb20524"
backend_db_repository = "https://github.com/JoseSC30/backend-control-asistencia.git"
frontend_repository   = "https://github.com/JoseSC30/frontend-control-asistencia.git"
repository_branch     = "main"
application_user      = "app"
database_name         = "appdb"
database_user         = "appuser"
